# Harrier configuration. ./setup.sh creates .env from this file and fills in what it can detect.
# Never commit .env: it holds passwords.

# --- Required -------------------------------------------------------------------------------
POSTGRES_PASSWORD=            # setup.sh generates one
ADMIN_USERNAME=admin          # first admin account, created on first start if there are no users
ADMIN_PASSWORD=               # setup.sh generates one and shows it once; change it after signing in

# --- Dashboard ------------------------------------------------------------------------------
HARRIER_PORT=8095
SECURE_COOKIE=false           # true when the dashboard is served over HTTPS
TRUSTED_PROXIES=127.0.0.0/8,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16   # proxies allowed to set X-Forwarded-For

# --- AI (Ollama) ----------------------------------------------------------------------------
# setup.sh looks for an Ollama that's already running and uses it; it only starts the bundled one
# (COMPOSE_PROFILES=ollama) when it finds none.
OLLAMA_URL=http://ollama:11434
MODEL=gemma4:12b              # any Ollama model with JSON output; change it any time in Settings
AI_ENABLED=true

# --- What to protect ------------------------------------------------------------------------
MODE=auto                     # auto: block clear attacks (time-limited); review: suggest only
DOMAINS=                      # comma-separated domains to watch from outside, e.g. example.com,www.example.com
BRAND_KEYWORD=                # flag new certificates for look-alike domains containing this word
WEB_SITE=                     # a site your Caddy serves, used by the self-checks (e.g. git.example.com)
ALLOW=                        # extra addresses/ranges never to block (home and private ranges always are)
EXPECTED_INBOUND_PORTS=80,443,51820,2222   # ports your router forwards here on purpose
APP_SSH_PORT=2222             # an SSH port to watch for password guessing (e.g. Forgejo/Gitea)
NTFY_URL=                     # phone alerts: an ntfy.sh topic URL

# --- Log sources (optional) -----------------------------------------------------------------
HOST_LOG_DIR=/var/log         # auth.log and ufw.log
CADDY_LOG_DIR=                # folder with Caddy's JSON access.log (see docs/Caddyfile.example)
KESTREL_DATA_DIR=             # Kestrel's data folder, if you run Kestrel
PIHOLE_URL=http://pihole      # Pi-hole v6, for every device's DNS activity
PIHOLE_PASSWORD=

# --- Docker wiring (setup.sh manages these) -------------------------------------------------
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=
EXTERNAL_NETWORK=             # an existing Docker network to join (where your Ollama / Pi-hole run)
POSTGRES_HOST_PORT=5433
