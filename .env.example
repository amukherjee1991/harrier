# Harrier configuration. ./setup.sh creates .env from this file and fills in what it can detect.
# Never commit .env: it holds passwords.

# --- Required -------------------------------------------------------------------------------
# setup.sh generates one
POSTGRES_PASSWORD=
# first admin account, created on first start if there are no users
ADMIN_USERNAME=admin
# setup.sh generates one and shows it once; change it after signing in
ADMIN_PASSWORD=

# --- Dashboard ------------------------------------------------------------------------------
HARRIER_PORT=8095
# true when the dashboard is served over HTTPS
SECURE_COOKIE=false
# The exact address(es) of YOUR reverse proxy, e.g. 172.20.0.5/32. Leave empty unless a proxy sits in front:
# any device that can reach the dashboard could otherwise claim to be any address.
TRUSTED_PROXIES=

# --- AI (Ollama) ----------------------------------------------------------------------------
# setup.sh looks for an Ollama that's already running and uses it; it only starts the bundled one
# (COMPOSE_PROFILES=ollama) when it finds none.
OLLAMA_URL=http://ollama:11434
# any Ollama model with JSON output; empty = setup.sh picks one that fits your hardware. Change it any time in Settings.
MODEL=
AI_ENABLED=true

# --- What to protect ------------------------------------------------------------------------
# auto: block clear attacks (time-limited); review: suggest only
MODE=auto
# comma-separated domains to watch from outside, e.g. example.com,www.example.com
DOMAINS=
# flag new certificates for look-alike domains containing this word
BRAND_KEYWORD=
# a site your Caddy serves, used by the self-checks (e.g. git.example.com)
WEB_SITE=
# extra addresses/ranges never to block (home and private ranges always are)
ALLOW=
# ports your router forwards here on purpose
EXPECTED_INBOUND_PORTS=80,443,51820,2222
# an SSH port to watch for password guessing (e.g. Forgejo/Gitea)
APP_SSH_PORT=2222
# phone alerts: an ntfy.sh topic URL
NTFY_URL=

# --- Log sources (optional) -----------------------------------------------------------------
# auth.log and ufw.log
HOST_LOG_DIR=/var/log
# folder with Caddy's JSON access.log (see docs/Caddyfile.example)
CADDY_LOG_DIR=
# Kestrel's data folder, if you run Kestrel
KESTREL_DATA_DIR=
# Pi-hole v6, for every device's DNS activity
PIHOLE_URL=http://pihole
PIHOLE_PASSWORD=

# --- Docker wiring (setup.sh manages these) -------------------------------------------------
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=
# an existing Docker network to join (where your Ollama / Pi-hole run)
EXTERNAL_NETWORK=
POSTGRES_HOST_PORT=5433
